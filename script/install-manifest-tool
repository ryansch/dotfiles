#!/usr/bin/env bash

set -euo pipefail

selected_binary="${1:?Missing required argument: selected binary}"
target="${HOME}/.local/bin/manifest-tool"

release=$(gh api /repos/estesp/manifest-tool/releases/latest)
tag=$(jq -r '.tag_name' <<<"${release}")

# `manifest-tool --version` prints e.g. "... version 2.2.2 (commit: ...)"
if [[ -x "${target}" && "$("${target}" --version 2>/dev/null)" == *"version ${tag#v} "* ]]; then
	echo "manifest-tool ${tag} is current"
	exit 0
fi

dir=$(mktemp -d -t "install-manifest-tool.XXXXXX")
function cleanup {
	rm -rf "${dir}"
}
trap cleanup EXIT

cd "${dir}"

download_url=$(jq -r '.assets[] | select(.name | contains("binaries-manifest-tool") and contains("sha256sum") | not) | .browser_download_url' <<<"${release}")
echo "Downloading from $download_url"
curl -fsSL "${download_url}" >binaries-manifest-tool.tar.gz

tar -xf binaries-manifest-tool.tar.gz

mkdir -p "$(dirname "${target}")"
cp -f "${selected_binary}" "${target}"
chmod +x "${target}"

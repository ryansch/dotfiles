#!/usr/bin/env bash

set -euo pipefail

name="git.ryansch.net"
url="https://git.ryansch.net"

if ! command -v tea >/dev/null 2>&1; then
  echo "tea is not installed; skipping Gitea login" >&2
  exit 0
fi

logins="$(tea login list --output simple 2>/dev/null || true)"
if awk -v url="$url" '$2 == url { found = 1 } END { exit !found }' <<<"$logins"; then
  echo "tea is already logged in to ${url}"
  exit 0
fi

if [[ "$OSTYPE" == darwin* || -n "${DISPLAY:-}" ]]; then
  tea login add --name "$name" --url "$url" --oauth
elif [[ ! -t 0 ]]; then
  echo "No TTY; skipping Gitea login. Run ${0} interactively to log in." >&2
else
  read -r -s -p "Gitea access token for ${url}: " token
  echo
  tea login add --name "$name" --url "$url" --token "$token"
fi

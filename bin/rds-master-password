#!/usr/bin/env bash

# Print the RDS-managed master password for a database, refreshing the SSO
# session first if it has lapsed.
#
# Built to be callable from a GUI app (e.g. TablePlus), which drives three
# design constraints:
#   * PATH is not inherited from the login shell, so the usual Homebrew bin
#     dirs are prepended below.
#   * ONLY the password goes to stdout. Every diagnostic, prompt and error
#     goes to stderr, or the caller ends up using a log line as a password.
#   * The password is printed with no trailing newline. Command substitution
#     strips one anyway, and consumers reading stdout verbatim should not get
#     a stray \n.
#
# No profile or region is baked in. Both come from the caller, either via the
# flags below or the standard AWS environment variables; region otherwise
# falls through to whatever the profile's config resolves.

set -euo pipefail

# GUI-launched processes get a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin).
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

PROFILE="${AWS_PROFILE:-}"
REGION=""
COPY=""

usage() {
  cat >&2 <<'EOF'
usage: rds-master-password [-p profile] [-r region] [-c] <db-identifier>

  -p  AWS profile (falls back to $AWS_PROFILE; required if that is unset)
  -r  AWS region  (falls back to the profile's configured region)
  -c  copy to the clipboard instead of printing

Accepts either an RDS instance or an Aurora cluster identifier. Requires the
database to use an RDS-managed master password (Secrets Manager).

  rds-master-password -p my-sso-profile my-postgres
  AWS_PROFILE=my-sso-profile rds-master-password -c my-postgres
EOF
  exit 64
}

while getopts ":p:r:ch" opt; do
  case "$opt" in
    p) PROFILE="$OPTARG" ;;
    r) REGION="$OPTARG" ;;
    c) COPY=1 ;;
    h) usage ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

[ $# -eq 1 ] || usage
DB="$1"

if [ -z "$PROFILE" ]; then
  echo "rds-master-password: no profile given and \$AWS_PROFILE is unset." >&2
  usage
fi

for bin in aws jq; do
  command -v "$bin" >/dev/null || { echo "rds-master-password: $bin not found on PATH" >&2; exit 127; }
done

# Region is only forwarded when the caller supplied one, so an unset -r defers
# to the profile's own configuration rather than a guess made here.
AWS_ARGS=(--profile "$PROFILE")
[ -n "$REGION" ] && AWS_ARGS+=(--region "$REGION")

# Refresh SSO if the session has lapsed. `aws sso login` opens a browser and
# blocks on approval, which is fine in a terminal but will stall a GUI caller,
# so say what is happening on stderr either way.
if ! aws sts get-caller-identity "${AWS_ARGS[@]}" >/dev/null 2>&1; then
  echo "rds-master-password: SSO session for '$PROFILE' is not valid; logging in..." >&2
  if ! aws sso login --profile "$PROFILE" >&2; then
    echo "rds-master-password: SSO login failed. Run 'aws sso login --profile $PROFILE' in a terminal." >&2
    exit 1
  fi
fi

# Instance first, then cluster — the identifier could be either, and asking
# for the wrong one is a hard error rather than an empty result.
SECRET=$(aws rds describe-db-instances "${AWS_ARGS[@]}" \
  --db-instance-identifier "$DB" \
  --query 'DBInstances[0].MasterUserSecret.SecretArn' --output text 2>/dev/null || true)

if [ -z "$SECRET" ] || [ "$SECRET" = "None" ]; then
  SECRET=$(aws rds describe-db-clusters "${AWS_ARGS[@]}" \
    --db-cluster-identifier "$DB" \
    --query 'DBClusters[0].MasterUserSecret.SecretArn' --output text 2>/dev/null || true)
fi

if [ -z "$SECRET" ] || [ "$SECRET" = "None" ]; then
  echo "rds-master-password: no RDS-managed master secret for '$DB' in profile '$PROFILE'." >&2
  echo "  Either the identifier is wrong, or the database does not use a managed master password." >&2
  exit 1
fi

PASSWORD=$(aws secretsmanager get-secret-value "${AWS_ARGS[@]}" \
  --secret-id "$SECRET" --query SecretString --output text | jq -r '.password')

if [ -z "$PASSWORD" ] || [ "$PASSWORD" = "null" ]; then
  echo "rds-master-password: secret has no 'password' field." >&2
  exit 1
fi

if [ -n "$COPY" ]; then
  printf '%s' "$PASSWORD" | pbcopy
  echo "rds-master-password: copied the master password for '$DB' to the clipboard." >&2
else
  printf '%s' "$PASSWORD"
fi
